# ==============================================================================
# StockMind-AI — Production Configuration Template (.env.production.example)
# Copy this file to '.env' on your production deployment target.
# NEVER commit the active '.env' file containing live secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_NAME=StockMind-AI
APP_VERSION=0.1.0
PROJECT_ROOT=/app

# ------------------------------------------------------------------------------
# 2. SERVER & GATEWAY NETWORKING
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
ALLOWED_ORIGINS=https://terminal.yourdomain.com,http://localhost:8501

# ------------------------------------------------------------------------------
# 3. PRODUCTION CRYPTOGRAPHY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32+ byte hex key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_replace_with_a_secure_64_char_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Production typically runs with PostgreSQL, or SQLite on USB/SSD volume
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=database/stockmind.db
DATABASE_URL=sqlite+aiosqlite:///./database/stockmind.db

# If using PostgreSQL:
# DATABASE_TYPE=postgresql
# POSTGRES_USER=stockmind_admin
# POSTGRES_PASSWORD=your_strong_postgres_password
# POSTGRES_SERVER=db
# POSTGRES_PORT=5432
# POSTGRES_DB=stockmind_db
# DATABASE_URL=postgresql+asyncpg://stockmind_admin:your_strong_postgres_password@db:5432/stockmind_db

# ------------------------------------------------------------------------------
# 5. MARKET DATA ENGINE & BROKER GATEWAY (NSE / BSE)
# ------------------------------------------------------------------------------
# Operational mode:
# - 'REPLAY': Zero credential requirement, runs off curated historical tick datasets.
# - 'LIVE': Requires active broker API registration (e.g. Angel One SmartAPI, Zerodha Kite).
MARKET_DATA_MODE=REPLAY
MARKET_DATA_PROVIDER=REPLAY
MARKET_DEFAULT_EXCHANGE=NSE

# Broker Credentials (REQUIRED if MARKET_DATA_MODE=LIVE)
# Manual Step: Register for API keys on developer portal of your broker.
MARKET_API_KEY=your_broker_api_key_here
MARKET_API_SECRET=your_broker_api_secret_here
MARKET_ACCESS_TOKEN=your_daily_session_token_here
MARKET_WS_URL=wss://smartapisocket.angelone.in/smart-stream

# External Financial News Feeds (Optional fallback)
NEWS_API_KEY=your_news_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ------------------------------------------------------------------------------
# 6. AI & MACHINE LEARNING INFERENCE CONFIGURATION
# ------------------------------------------------------------------------------
DEVICE=cpu
MODEL_STORAGE_DIR=models/
DATA_RAW_DIR=data/raw/
DATA_PROCESSED_DIR=data/processed/
DATA_CACHE_DIR=data/cache/
DEFAULT_PREDICTION_HORIZON_DAYS=5

# ------------------------------------------------------------------------------
# 7. LOGGING & AUDIT TRAIL
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs/
LOG_FILE_NAME=stockmind_production.log
LOG_ROTATION=50 MB
LOG_RETENTION=30 days
