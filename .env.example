# ==============================================================================
# StockMind-AI — Environment Configuration Template
# Copy this file to '.env' and update the values for your local environment.
# DO NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true
APP_NAME=StockMind-AI
APP_VERSION=0.1.0
PROJECT_ROOT=D:\StockMind-AI

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local development can default to SQLite or PostgreSQL
DATABASE_TYPE=sqlite                   # Options: sqlite, postgresql
SQLITE_DB_PATH=database/stockmind.db
POSTGRES_USER=stockmind_user
POSTGRES_PASSWORD=stockmind_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockmind_db
DATABASE_URL=sqlite+aiosqlite:///./database/stockmind.db

# ------------------------------------------------------------------------------
# 5. CACHING & BROKER (REDIS)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. INDIAN STOCK MARKET & REAL-TIME DATA ENGINE (NSE / BSE)
# ------------------------------------------------------------------------------
# Operational mode: 'LIVE' (requires real broker credentials) or 'REPLAY' (safe local historical simulation)
MARKET_DATA_MODE=REPLAY
MARKET_DATA_PROVIDER=REPLAY            # Options: REPLAY, ZERODHA, UPSTOX, FINVASIA, ANGELONE
MARKET_DEFAULT_EXCHANGE=NSE            # Options: NSE, BSE
MARKET_API_KEY=your_broker_api_key_here
MARKET_API_SECRET=your_broker_api_secret_here
MARKET_ACCESS_TOKEN=your_broker_daily_access_token_here
MARKET_WS_URL=wss://ws.broker-gateway.example/stream

# Global Providers (Optional fallback feeds)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
FINANCIAL_MODELING_PREP_API_KEY=your_fmp_api_key_here
NEWS_API_KEY=your_news_api_key_here

# ------------------------------------------------------------------------------
# 7. AI & MACHINE LEARNING ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
DEVICE=cpu                             # Options: cpu, cuda (if compatible GPU available)
MODEL_STORAGE_DIR=models/
DATA_RAW_DIR=data/raw/
DATA_PROCESSED_DIR=data/processed/
DATA_CACHE_DIR=data/cache/
DEFAULT_PREDICTION_HORIZON_DAYS=5

# ------------------------------------------------------------------------------
# 8. LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                         # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs/
LOG_FILE_NAME=stockmind.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
